# Pigo global configuration (example template)
#
# For anything this static file cannot express (secrets from `pass`/`op`, per-host
# conditionals, includes, shell-function hooks), use the Bash config script
# instead: $PIGO_HOME/pigorc (default ~/.pigo/pigorc) and ./.pigorc. Its options
# override this file, and an explicit CLI flag still overrides both. See the
# "pigorc" section of README.md for the full key-by-key mapping.
# Copy this file to ~/.config/pigo/config.toml and fill in your own values.
# https://github.com/smallnest/pigo

# Provider base URL (overrides the provider's default endpoint).
# Leave unset to use the selected provider's built-in default.
# base_url = "https://api.anthropic.com/v1"

# Default model to use.
model = "claude-opus-4-8"

# API key for authentication.
# Prefer supplying this via the <PROVIDER>_API_KEY environment variable
# (e.g. ANTHROPIC_API_KEY) instead of committing it to a config file.
# api_key = "your-api-key-here"

# Output format: text | stream-json
output_format = "text"

# Trust the working directory for this run: skip the first-launch trust prompt.
approve = false

# Disable the built-in file/shell tools.
no_tools = false

# Tool-level admission control (the middle ground between "all tools" and
# no_tools). Names match case-insensitively, so "Read" hits the built-in "read".
# disallowed_tools wins when a name appears in both lists (fail-closed).
#
# A boundary declared here is a HARD boundary: filtering happens at the tool-
# registration layer, so `approve = true` waives per-call confirmation but can
# never let the model reach a tool outside the boundary. Task sub-agents inherit
# it too. An unknown tool name aborts startup with exit code 2 rather than being
# silently ignored.
#
# Each CLI flag REPLACES its own file value wholesale (it does not merge):
# --allowed-tools overrides allowed_tools, --disallowed-tools overrides
# disallowed_tools, independently. So a CLI --allowed-tools can widen what
# allowed_tools narrowed. Note the two lists stay independent and deny still
# wins: a file-level disallowed_tools is NOT lifted by a CLI --allowed-tools —
# to re-admit a tool the file denied, override --disallowed-tools on the CLI.
# Parameter-level forms such as Bash(git log:*) are not supported yet.
# allowed_tools = ["read", "grep"]
# disallowed_tools = ["bash", "bash_output", "kill_bash"]

# Disable skill discovery (do not load skills under ~/.agents/skills; /skill has nothing to select and model auto-invocation is off).
no_skills = false

# Force wire protocol for a custom endpoint: openai | openai/resp_api | anthropic
# (openai and openai/chat are the same Chat Completions wire; openai/resp_api
#  targets POST {base_url}/responses for endpoints that only speak that API)
# protocol = "anthropic"

# Run in headless print mode with the given prompt.
# print = ""

# Resume the most recent interactive session.
# continue = false

# List stored interactive sessions and exit.
# list_sessions = false

# Resume the interactive session with this id.
# resume = ""

# Internal: run as a process-isolated sub-agent JSON-RPC server over stdio (US-019).
# subagent_rpc = false

# --- Third-party providers (array of tables) ---
# Define a gateway that is not in pigo's built-in registry, then use it like a
# built-in one: --provider <name>, --model <id> inference, /model switching and
# the preset picker all work. Everything except name (and base_url, unless the
# provider speaks the public Anthropic API) is optional. The key is resolved from
# env_var (default <NAME>_API_KEY), a named credential, or the environment —
# prefer those over an inline api_key.
#
# [[providers]]
# name       = "mycorp"
# protocol   = "openai"                    # openai | openai/resp_api | anthropic
# base_url   = "https://llm.mycorp.com/v1"
# env_var    = "MYCORP_API_KEY"
# credential = "mycorp-work"               # name in ~/.pigo/.credentials.yaml
# auth       = "bearer"                    # bearer | x-api-key
# models     = ["mycorp-large", "mycorp-small"]  # first one is the default
#   Image support is NOT a provider setting: one gateway routinely serves both
#   vision and text-only ids, so it is declared per model (see [[models]] below).
#
# --- Models (array of tables) ---
# Models are declared separately from providers: a provider is an endpoint, a
# model is an id with its own capabilities. This is how one gateway serves both
# a vision model and a text-only one.
#
# [[models]]
# id              = "mycorp-vl"
# provider        = "mycorp"               # a [[providers]] name or a built-in
# display_name    = "MyCorp Vision"        # optional, defaults to id
# supports_images = true                   # declare it a vision model
#
# [[models]]
# id              = "mycorp-text"
# provider        = "mycorp"
# supports_images = false                  # pin one id text-only
#
#   supports_images is the only image-capability setting and is what the
#   view_image tool (and read on an image file) consults: true hands the model
#   the picture, false reports it as text. Omit the key for pigo's default for
#   the provider kind: text-only for a hand-configured endpoint (so declare its
#   vision ids explicitly), vision-capable for a built-in provider. The
#   equivalent pigorc form is
#   `model add mycorp-vl --provider mycorp --supports-images`.
#   `/model` and `/status` always print which of the three applies.

# --- MCP servers (array of tables) ---
# Connect external Model Context Protocol servers; their tools are exposed to the
# model as mcp__<name>__<tool>. Use command/args/env for stdio servers, or
# url/headers for a Streamable HTTP server.
#
# [[mcp]]
# name    = "github"
# url     = "https://api.githubcopilot.com/mcp/"
# timeout_seconds = 60
# [mcp.headers]
# Authorization = "Bearer ..."
#
# [[mcp]]                      # OAuth on 401 (browser approval, cached token)
# name  = "hosted"
# url   = "https://mcp.example.com/mcp"
# oauth = true
#
# [[mcp]]                      # legacy HTTP+SSE transport
# name      = "legacy"
# url       = "https://legacy.example.com/mcp"
# transport = "sse"
#
# [[mcp]]
# name    = "files"
# command = "npx"
# args    = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
# [mcp.env]
# LOG_LEVEL = "warn"

# --- Custom sub-agents ---
# Custom agents are defined in the pigorc only (their single source of truth):
#   agent add researcher --description "..." --prompt-file ./researcher.md \
#     --tools read,grep --model claude-haiku-4
# See the "自定义 sub-agent" section of README.md.

# --- Persistent memory + infinite context (nested tables) ---

# [memory] controls the persistent memory system. All keys are optional and
# default to the values shown; set memory.enabled = false to fully disable it.
# [memory]
# enabled = true              # master switch for the memory system
# reconcile_on_search = true  # lazily re-index memory files before each search
# search_score_floor = 0.15   # drop search hits below this relevance score (0..1)
# cc_index = false            # also index the Claude Code memory directory (read-only)

# [checkpoint] controls infinite-context checkpointing.
# [checkpoint]
# thresholds = ["40%", "60%", "80%"]  # context-window fill levels that trigger compaction
# reserved = 4096                     # optional: tokens to reserve (int) or a percentage ("10%")

# [checkpoint.push_caps] caps per-section injection token budgets.
# [checkpoint.push_caps]
# memory = 800
# recall = 1200

# [compaction] tunes auto-compaction.
# [compaction]
# max_context accepts a token count (300000), a K/M suffix ("300K", "1M"), or a
# percentage of the provider window ("50%"). It only lowers the trigger point and
# is always clamped by the provider limit.
# max_context = "300K"
